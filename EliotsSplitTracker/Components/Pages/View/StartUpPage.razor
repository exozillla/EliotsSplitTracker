@page "/"

<div class="min-h-screen bg-zinc-900 text-neutral-100 flex flex-col items-center justify-center p-6">
    <div class="w-full max-w-md bg-neutral-700 border border-orange-400 rounded-3xl p-12 shadow-2xl space-y-13">
        
        <div class="text-center">
            <span class="text-xs font-semibold tracking-wider text-orange-400 uppercase">
                Eliot's Split Tracker
            </span>
            <h1 class="text-3xl font-black text-white mt-3">Hello User!</h1>
        </div>

        <div class="bg-zinc-800 border border-orange-400 rounded-2xl p-5 text-center">
            <p class="text-sm font-medium text-orange-400 uppercase tracking-wide">Today's Focus:</p>
            <h2 class="text-4xl font-extrabold text-neutral-100 mt-1" @bind="todaysFocus"></h2>
        </div>

        <div class="flex justify-between items-center px-2 text-sm">
            <h1 class="text-slate-400 font-medium">Up Next:</h1>
            <h1 class="text-white font-semibold bg-slate-800 px-3 py-1 rounded-lg" @bind=""></h1>
        </div>

        <div class="grid grid-cols-2 gap-5" >
            <button class="bg-orange-400 active:scale-[0.97] hover:bg-slate-400 hover:border-slate-700 text-slate-950 font-bold py-2 px-4 border-b-4 border-orange-500 rounded-2xl shadow-lg shadow-orange-500/10 transition-all duration-100 text-2xl">
                Setup
            </button>
            <button class="bg-orange-400 active:scale-[0.97] hover:bg-slate-300 hover:border-slate-600 text-slate-950 font-bold py-2 px-4 border-b-4 border-orange-500 rounded-2xl shadow-lg shadow-orange-500/10 transition-all duration-100 text-2xl">
                Next
            </button>
        </div>
        
    </div>
</div>





